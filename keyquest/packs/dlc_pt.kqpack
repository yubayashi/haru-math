  "stages": [
    {
      "id": "pt_s32",
      "no": 32,
      "name": "みなとの ことば",
      "teach": "みじかい ポルトガル語",
      "mode": "kana",
      "bg": "plain",
      "pos": [
        20,
        60
      ],
      "timed": true,
      "desc": "見たまま うつ。日本語に しなくて いい。L の キーが たくさん 出てくる。",
      "unlockSkill": null,
      "battles": [
        {
          "enemy": "pt_sardinha",
          "q": 8,
          "wordlist": "wl_pt1",
          "hint": "L は みぎての くすりゆび。日本語では ほとんど 出ない キー。"
        },
        {
          "enemy": "pt_galo",
          "q": 8,
          "wordlist": "wl_pt1",
          "hint": "F と V を 見まちがえない。faca と vaca は べつの ことば。"
        },
        {
          "enemy": "pt_sardinha",
          "q": 8,
          "wordlist": "wl_pt1",
          "hint": "てもとを 見ないで うてたら すごい。"
        },
        {
          "enemy": "ptb_caravela",
          "q": 12,
          "wordlist": "wl_pt1",
          "hint": "カラベルせん！ うみへ 出る ふねだ。",
          "boss": true
        }
      ],
      "kbhelp": true
    },
    {
      "id": "pt_s33",
