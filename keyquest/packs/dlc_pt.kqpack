  "cards": [
    {
      "id": "cd_pt_l",
      "name": "L の キー",
      "rarity": "SR",
      "type": "キーボード",
      "art": "enemy:ptb_caravela",
      "tip": "日本語を ローマ字で うつと、L は ほとんど 出てこない。でも ポルトガル語や 英語では とても よく 出る。だから L が 苦手な まま に なりやすい。この島で かせいでおくと あとが らく。",
      "series": 2
    },
    {
      "id": "cd_pt_galo",
      "name": "バルセロスの おんどり",
      "rarity": "R",
      "type": "ポルトガル",
      "art": "enemy:pt_galo",
      "tip": "ポルトガルの おみやげで いちばん 有名な おんどり。むかし、ころされそうな 人の むじつを しょうめいするため、こんがり やけた おんどりが 立ちあがって ないた、という はなしから。",
      "series": 2
    },
    {
      "id": "cd_pt_azulejo",
      "name": "アズレージョ",
      "rarity": "R",
      "type": "ポルトガル",
      "art": "enemy:pt_azulejo",
      "tip": "ポルトガルの まちの かべを おおう 青い タイル。もとは アラビア語の「みがいた 小石」から きた ことば。駅や 教会の かべに 大きな 絵が かいてある。",
      "series": 2
    },
    {
      "id": "cd_pt_nata",
      "name": "パステル・デ・ナタ",
      "rarity": "SR",
      "type": "ポルトガル",
      "art": "enemy:ptb_torre",
      "tip": "ベレンの しゅうどういんで 生まれた たまごの タルト。しゅうどうしが 服に のりを つけるのに 卵白を つかい、あまった 黄身で おかしを 作ったのが はじまり。",
      "series": 2
    }
  ],
