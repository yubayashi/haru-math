        {
          "enemy": "pt_sardinha",
          "q": 4,
          "wordlist": "wl_pt3",
          "hint": "C が たくさん 出る。ひだり手の なかゆび。"
        },
        {
          "enemy": "pt_azulejo",
          "q": 4,
          "wordlist": "wl_pt3",
