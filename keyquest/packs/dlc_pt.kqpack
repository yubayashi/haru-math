        },
        {
          "enemy": "ptb_torre",
          "q": 5,
          "wordlist": "wl_pt3",
          "hint": "ベレンの とう！ いちばん ながい ことばが くる。",
          "boss": true
        }
      ]
    },
    {
      "id": "pt_s35",
      "no": 35,
      "name": "ふたつの ことばの とう",
      "teach": "みじかい ぶんを まるごと",
      "mode": "kana",
      "bg": "rocky",
      "pos": [
        88,
        60
