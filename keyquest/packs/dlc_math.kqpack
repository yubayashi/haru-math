  "stages": [
    {
      "id": "m_s27",
      "no": 27,
      "name": "九九の ひろば",
      "teach": "九九を 見た しゅんかんに 答える",
      "mode": "kana",
      "bg": "plain",
      "pos": [
        18,
        62
      ],
      "numrow": true,
      "timed": true,
      "recall": true,
      "recallMs": 4000,
      "desc": "まずは 九九。ゆびは ホームポジション、目は がめん。4の だんと 9が でたら ようちゅうい。",
      "unlockSkill": null,
      "battles": [
        {
          "enemy": "mt_zero",
          "q": 8,
          "wordlist": "wl_kuku",
          "hint": "数字は いちばん うえの だん。ゆびを のばして すぐ もどす。"
        },
        {
          "enemy": "mt_kuri",
          "q": 8,
          "wordlist": "wl_kuku",
          "hint": "わかったら すぐ うつ。まよったら まっても いい。"
        },
        {
          "enemy": "mt_zero",
          "q": 8,
          "wordlist": "wl_kuku",
          "hint": "4の だんが きた。ここが いちばん てこずる ところ。"
        },
        {
          "enemy": "mtb_kuku",
          "q": 12,
          "wordlist": "wl_kuku",
          "hint": "くくの りゅう！ 9の だんで せめてくるぞ。",
          "boss": true
        }
      ],
      "kbhelp": true
    },
    {
