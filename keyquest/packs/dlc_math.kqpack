  "cards": [
    {
      "id": "cd_mt_kuku",
      "name": "九九",
      "rarity": "R",
      "type": "すうじ",
      "art": "enemy:mtb_kuku",
      "tip": "九九は 81こ ある ように 見えて、3×4 と 4×3 は おなじ 答え。だから ほんとうに おぼえるのは 45こで いい。",
      "series": 2
    },
    {
      "id": "cd_mt_zero",
      "name": "ゼロ",
      "rarity": "R",
      "type": "すうじ",
      "art": "enemy:mt_zero",
      "tip": "0 は キーボードの 数字の いちばん みぎ。1 の となりでは ない。1 から じゅんに ならんで、9 の つぎが 0。",
      "series": 2
    },
    {
      "id": "cd_mt_kansuu",
      "name": "漢数字",
      "rarity": "SR",
      "type": "すうじ",
      "art": "enemy:mtb_kansuu",
      "tip": "日本語の 大きな 数は **4けたごと**に 名前が かわる（万・億・兆）。えいごは 3けたごと（thousand・million）。だから 1,000,000 は えいごでは 1 million、日本語では 百万に なる。",
      "series": 2
    },
    {
      "id": "cd_mt_tani",
      "name": "たんい",
      "rarity": "SR",
      "type": "すうじ",
      "art": "enemy:mtb_tani",
      "tip": "k（キロ）は 1000ばい という いみ。km も kg も kL も おなじ。だから 1km＝1000m、1kg＝1000g。おぼえるのは k だけで いい。",
      "series": 2
    }
  ],
