    {
      "id": "sh_s12",
      "no": 12,
      "name": "そらの みなと",
      "teach": "ながれてくる てきを おとす（F と J）",
      "mode": "shoot",
      "bg": "hill",
      "pos": [
        26,
        60
      ],
      "timed": false,
      "desc": "みぎから てきが やってくる。もじの キーを おして おとそう。",
      "unlockSkill": null,
      "battles": [
        {
          "enemy": "sh_bird",
          "q": 12,
          "gen": {
            "pool": "fj",
            "speed": 1.2,
            "spawn": 1900
          },
          "hint": "てきに ついた もじの キーを おす。ゆびは ホームポジションから うごかさない。 まずは F と J だけ。"
        },
        {
          "enemy": "sh_bird",
          "q": 14,
          "gen": {
            "pool": "fjdk",
            "speed": 1.35,
            "spawn": 1700
          },
          "hint": "D と K が ふえた。ゆびは ホームに おいたまま。"
        },
