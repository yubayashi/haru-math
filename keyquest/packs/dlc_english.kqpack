    {
      "id": "en_s18",
      "no": 18,
      "name": "アルファベットの もん",
      "teach": "えいごを そのまま うつ（3もじ）",
      "mode": "kana",
      "bg": "rocky",
      "pos": [
        24,
        62
      ],
      "timed": true,
      "desc": "ローマ字では なく、えいごの ことばを そのまま うつ。まずは 3もじから。",
      "unlockSkill": null,
      "battles": [
        {
          "enemy": "en_abc",
          "q": 6,
          "wordlist": "wl_en3",
