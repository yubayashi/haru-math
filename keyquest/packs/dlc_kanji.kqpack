 "cards": [
  {
   "id": "cd_kj_yomi",
   "name": "よみ",
   "rarity": "R",
   "type": "かんじ",
   "art": "enemy:kj_maigo",
   "tip": "パソコンで 漢字を 出すときは、いつも「よみ」を うつ。よみさえ しっていれば、漢字は パソコンが 出してくれる。だから よみを おぼえるのが 近道。"
  },
  {
   "id": "cd_kj_okuri",
   "name": "おくりがな",
   "rarity": "R",
   "type": "かんじ",
   "art": "enemy:kj_sakasa",
   "tip": "「大きい」の うしろの「きい」を おくりがな と いう。ここが かわると いみも かわる。「大きい」と「大した」は べつの ことば。"
  },
  {
   "id": "cd_kj_juku",
   "name": "じゅくじくん",
   "rarity": "SR",
   "type": "かんじ",
   "art": "enemy:kjb_koto",
   "tip": "「今日＝きょう」は 今＝きょ、日＝う では ない。ことば ぜんたいで よみが きまる。これを じゅくじくん と いう。「大人」「明日」「果物」も なかま。"
  },
  {
   "id": "cd_kj_fude",
   "name": "ふで",
   "rarity": "SR",
   "type": "どうぐ",
   "art": "enemy:kjb_fude",
   "tip": "むかしは 文字を ふでで 書いた。いまは キーボードで うつ。どちらも「どの ゆびを どう うごかすか」を 手が おぼえると はやくなる。"
  }
 ],
