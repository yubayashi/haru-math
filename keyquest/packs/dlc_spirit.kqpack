  "stages": [
    {
      "id": "sp_s16",
      "no": 16,
      "name": "アクアの ま",
      "teach": "A S D K（日本語で よく出る キー）",
      "mode": "kana",
      "bg": "cave",
      "pos": [
        24,
        60
      ],
      "timed": true,
      "desc": "ホームポジションの うち、にほんごで よく つかう 4つ。ゆびを おいたまま うつ。",
      "unlockSkill": null,
      "battles": [
        {
          "enemy": "sp_kage",
          "q": 5,
          "wordlist": "wl_sp_ask",
          "hint": "ゆびは ホームから はなさない。"
        },
        {
          "enemy": "sp_kage",
          "q": 6,
          "wordlist": "wl_sp_ask",
          "hint": "うったら すぐ もとの いちに もどす。"
        },
        {
          "enemy": "sp_mayoi",
          "q": 6,
          "wordlist": "wl_sp_ask",
          "hint": "てもとを 見ないほうが はやい。"
        },
        {
          "enemy": "spb_aqua",
          "q": 10,
          "wordlist": "wl_sp_ask",
          "boss": true,
          "hint": "アクアの しれん！ あわてず ていねいに。"
        }
      ]
    },
    {
      "id": "sp_s17",
      "no": 17,
      "name": "きずなの ま",
      "teach": "ながい ことばでも 手を うごかさない",
      "mode": "kana",
      "bg": "forest",
      "pos": [
        42,
        30
      ],
      "timed": true,
      "desc": "ことばが ながくなっても、ゆびは ホームポジションに もどる。",
      "unlockSkill": null,
      "battles": [
        {
          "enemy": "sp_mayoi",
          "q": 4,
          "wordlist": "wl_sp_ask2",
          "hint": "ながくても やることは 同じ。"
        },
        {
          "enemy": "sp_mayoi",
          "q": 4,
          "wordlist": "wl_sp_ask2",
          "hint": "1もじ うつたびに ホームへ。"
        },
        {
          "enemy": "sp_tobira",
          "q": 5,
          "wordlist": "wl_sp_ask2",
          "hint": "リズムを そろえると はやくなる。"
        },
        {
          "enemy": "spb_aqua",
          "q": 8,
          "wordlist": "wl_sp_ask2",
          "boss": true,
          "hint": "ここまで くれば にほんごは だいじょうぶ。"
        }
      ]
    },
    {
      "id": "sp_s18",
      "no": 18,
      "name": "フレアと ジェイドの ま",
      "teach": "F と J（にほんごでは 出てこない 基準キー）",
      "mode": "shoot",
      "bg": "plain",
      "pos": [
        62,
        26
      ],
      "timed": false,
      "desc": "F と J は でっぱりの ある きじゅんの キー。にほんごを うつだけでは れんしゅうできない。",
      "unlockSkill": null,
      "battles": [
        {
          "enemy": "sp_kage",
          "q": 30,
          "gen": {
            "pool": "fj",
            "speed": 1.2,
            "spawn": 1800,
            "penalty": true
          },
          "hint": "F と J だけ。でっぱりを ゆびで さがす。"
        },
        {
          "enemy": "sp_mayoi",
          "q": 34,
          "gen": {
            "pool": "fj",
            "speed": 1.35,
            "spawn": 1600,
            "penalty": true
          },
          "hint": "はやくなった。からうちすると てきが にげるので ねらって うつ。"
        },
        {
          "enemy": "spb_flare",
          "q": 40,
          "gen": {
            "pool": "fjdk",
            "speed": 1.5,
            "spawn": 1450,
            "penalty": true
          },
          "boss": true,
          "hint": "フレアの しれん！ D と K も まざる。"
        }
      ]
    },
    {
      "id": "sp_s19",
      "no": 19,
      "name": "ルーナと セレネの ま",
